{
  "name": "inductio",
  "version": "0.4.0",
  "description": "A content-addressed, auditable foundation for LLM agent systems.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "nentum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nentum/inductio.git"
  },
  "homepage": "https://github.com/nentum/inductio#readme",
  "bugs": {
    "url": "https://github.com/nentum/inductio/issues"
  },
  "sideEffects": false,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.0"
  },
  "os": [
    "win32",
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "schema/003-axiomatic-v2.sql",
    "README.md",
    "RELEASE-SCOPE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "llm",
    "content-addressed",
    "event-sourcing",
    "sqlite",
    "durable",
    "runtime",
    "semantics"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "frozen:check": "node scripts/frozen-check.ts",
    "build": "node scripts/build-package.ts",
    "test:axiomatic": "node --test --test-reporter=spec test/unit/axiomatic-v2.test.ts",
    "test:public": "node --test --test-reporter=spec test/unit/in-memory-agent-runtime.test.ts test/unit/policy-sandbox.test.ts test/unit/policy-plugin-runtime.test.ts",
    "test:unit": "node --test --test-reporter=spec test/unit/*.test.ts",
    "test:multiprocess": "node --test --test-reporter=spec test/multiprocess/*.test.ts",
    "test:crash": "node --test --test-reporter=spec test/crash/*.test.ts",
    "test:live:models": "node --test --test-reporter=spec test/live-model-adapters.test.ts",
    "test": "npm run test:unit && npm run test:multiprocess && npm run test:crash",
    "package:check": "node scripts/package-check.ts",
    "check:source": "npm run typecheck && npm run frozen:check && npm test",
    "check": "npm run check:source && npm run build && npm run package:check",
    "release:check": "npm run check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
