{
  "name": "inductio",
  "version": "0.1.0",
  "description": "Content-addressed, policy-bounded Agent semantics with a deterministic offline in-memory runtime.",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.0"
  },
  "os": [
    "win32",
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "RELEASE-SCOPE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "content-addressed",
    "deterministic",
    "runtime",
    "semantics"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-package.ts",
    "test:axiomatic": "node --test --test-reporter=spec test/unit/axiomatic-v2.test.ts",
    "test:public": "node --test --test-reporter=spec test/unit/in-memory-agent-runtime.test.ts",
    "test": "npm run test:axiomatic && npm run test:public",
    "package:check": "node scripts/package-check.ts",
    "release:check": "npm run typecheck && npm run test && npm run build && npm run package:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
